+#define TAS_FAULTS0         0x07u
+#define TAS_FAULTS1         0x0eu
+
+#define TAS_DVC             0x0cu
+#define TAS_ICN_THRESHOLD   0x64u
+#define TAS_ICN_HYSTERESIS  0x6cu
+
+#define TAS_MISC_CLASSD     0x21u
+#define TAS_CMP_HYST        0x08u
+
+#define TAS_ICN_PAGE        0xfdu
+#define TAS_ICN_PAGE_CFG    0x0du
+#define TAS_CLASSD_CFG1     0x19u
