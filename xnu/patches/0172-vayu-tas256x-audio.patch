+/*
+ * Speaker amplifiers for Poco X3 Pro (vayu, SM8150-AC):
+ *   0x4c: TI TAS2562 (bottom speaker, right channel), SDZ GPIO 92 (north)
+ *   0x4d: TI TAS2564 (earpiece / top speaker, left channel), SDZ GPIO 89 (north)
+ *
+ * Bit-banged I2C on QUP0 SE7 (GPIO 98 SDA, GPIO 99 SCL, south TLMM 0x03d00000);
+ * pin configuration is saved and restored around each transaction.
+ * Audio arrives over QUAT_MI2S_RX (GPIO 137-140) driven by the ADSP (hakios.sound.c).
+ *
+ * Register sequence and safety caps follow telegdyd/ios-vayu (vayu_audio.c) and
+ * Linux tas256x: hardware limiter enabled on TAS2562, TAS2562 DVC capped at
+ * -6 dB (index 52), TAS2564 DVC capped at -18 dB (index 46), fault polling on
+ * latched registers 0x24/0x25, and panic-safe quiesce() driving SDZ low.
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_time.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+#include <sys/hakios.audio.h>
+#include <vm/memory_types.h>
+
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, unsigned int flags);
+extern kern_return_t thread_terminate(thread_t thread);
+extern void loader_log_putc(char c);
+
+void vayu_tas256x_init(void);
+bool vayu_tas256x_prepare(void);
+bool vayu_tas256x_start(void);
+bool vayu_tas256x_volume(uint32_t below, uint32_t step_ms);
+bool vayu_tas256x_healthy(void);
+void vayu_tas256x_stop(void);
+void vayu_tas256x_quiesce(void);
+uint32_t vayu_tas256x_monitor(bool tell);
+
+#define TLMM_NORTH_PA       0x03900000u
+#define TLMM_SOUTH_PA       0x03d00000u
+#define TLMM_MAP_SIZE       0x00100000u
+#define PIN_SDA             98u
+#define PIN_SCL             99u
+#define PIN_SDZ_LEFT        89u
+#define PIN_SDZ_RIGHT       92u
+#define CFG_OUTPUT          (1u << 9)
+
+#define TAS_PAGE            0x00u
+#define TAS_RESET           0x01u
+#define TAS_POWER           0x02u
+#define TAS_POWER_OFF       0x0eu
