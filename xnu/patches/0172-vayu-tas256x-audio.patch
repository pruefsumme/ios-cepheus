+
+#define DVC_DEFAULT         52u     /* -6 dB cap for TAS2562 bottom speaker */
+#define EAR_DVC_DEFAULT     46u     /* -18 dB cap for TAS2564 earpiece */
+
+static const uint8_t dvc_table[56][4] = {
