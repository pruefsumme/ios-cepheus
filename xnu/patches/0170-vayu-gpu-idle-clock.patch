+extern volatile uint32_t sweet_fb_display_off;
 
 void sweet_gpu_init(void);
 bool sweet_gpu_ready(void);
@@ -65,6 +66,11 @@ static vm_offset_t pool_kva;
 static vm_offset_t pt_kva;
 static uint64_t pt_pa;
 static volatile bool gpu_ready;
+static int gpu_idle_en = 1;
+static uint64_t gpu_last_submit_abs;
+static int gpu_idle_chan;
+static unsigned gpu_idle_logs;
+static uint32_t gpu_idle_drops;
 static LCK_GRP_DECLARE(sweet_gpu_grp, "sweet_gpu");
 static LCK_MTX_DECLARE(sweet_gpu_lock, &sweet_gpu_grp);
 
@@ -273,18 +279,59 @@ gpu_bus_vote(void)
 	}
 }
 
+static void
+gpu_idle_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint64_t deadline, now, ns;
+	int rc;
+
+	for (;;) {
+		clock_interval_to_deadline(250, NSEC_PER_MSEC, &deadline);
+		(void)assert_wait_deadline(&gpu_idle_chan, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+		lck_mtx_lock(&sweet_gpu_lock);
+		if (gpu_ready && gpu.cur_perf_level > 1 && gpu.perf_level > 1 &&
+		    a6_fence_done(&gpu, gpu.fence)) {
+			now = mach_absolute_time();
+			ns = 0;
+			if (gpu_last_submit_abs != 0 && now > gpu_last_submit_abs) {
+				absolutetime_to_nanoseconds(now - gpu_last_submit_abs, &ns);
+			}
+			if (sweet_fb_display_off || ns >= 500000000ULL) {
+				rc = a6_set_perf_level(&gpu, 1);
+				if (rc == 0) {
+					gpu_idle_drops++;
+				}
+				if (rc != 0 || gpu_idle_logs < 6) {
+					gpu_idle_logs++;
+					a6_log("idle: drop to lvl 1 (257 MHz, off=%u, drops=%u) -> %d\n",
+					    sweet_fb_display_off, gpu_idle_drops, rc);
+				}
+			}
+		}
+		lck_mtx_unlock(&sweet_gpu_lock);
+	}
+}
+
 static void
 gpu_thread(void *arg __unused, wait_result_t wr __unused)
 {
 	uint64_t t0 = mach_absolute_time(), ns;
+	thread_t idle_thr;
 	gpu_bus_vote();
 	lck_mtx_lock(&sweet_gpu_lock);
 	int rc = a6_power_up(&gpu);
 	if (!rc) {
 		a6_unmap_high(&gpu);
+		gpu_last_submit_abs = mach_absolute_time();
 		gpu_ready = true;
 	}
 	lck_mtx_unlock(&sweet_gpu_lock);
+	if (!rc && gpu_idle_en && gpu.perf_level > 1) {
+		if (kernel_thread_start(gpu_idle_thread, NULL, &idle_thr) == KERN_SUCCESS) {
+			thread_deallocate(idle_thr);
+		}
+	}
 	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
 	a6_log("bring-up %s in %llu ms (pool 0x%llx)\n", rc ? "FAILED" : "done, GPU ready", ns / 1000000,
 	    gpu.pool_pa);
@@ -314,6 +361,7 @@ sweet_gpu_init(void)
 		a6_log("675 MHz needs a speed-bin 1 GPU (fuse says %u): using 585\n", gpu_speed_bin());
 		lvl = 5;
 	}
+	PE_parse_boot_argn("sweetgpuidle", &gpu_idle_en, sizeof(gpu_idle_en));
 	gpu.perf_level = lvl;
 	pool_kva = va;
 	vm_offset_t pva = 0;
@@ -427,9 +475,20 @@ static void
 gpu_note_submit_locked(void)
 {
 	uint32_t done = a6_fence_read(&gpu);
+	uint64_t now = mach_absolute_time();
+	int rc;
+
 	if (done == gpu.fence) {
 		progress_fence = done;
-		progress_abs = mach_absolute_time();
+		progress_abs = now;
+	}
+	gpu_last_submit_abs = now;
+	if (gpu_idle_en && gpu.cur_perf_level != gpu.perf_level) {
+		rc = a6_set_perf_level(&gpu, gpu.perf_level);
+		if (rc != 0 || gpu_idle_logs < 6) {
+			gpu_idle_logs++;
+			a6_log("idle: boost to lvl %u -> %d\n", gpu.perf_level, rc);
+		}
 	}
 	gpu_stats_locked();
 }
