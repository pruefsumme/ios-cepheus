diff --git a/bsd/dev/sweet_a6xx.c b/bsd/dev/sweet_a6xx.c
index 62beb71..537eeee 100644
--- a/bsd/dev/sweet_a6xx.c
+++ b/bsd/dev/sweet_a6xx.c
@@ -638,6 +638,9 @@ static int gmu_hfi(struct a6_gpu *g)
 	msg[2] = lvl;			/* index into gpu_khz */
 	msg[3] = 0;
 	rc |= hfi_send(g, 30, msg, 4);
+	if (rc == 0) {
+		g->cur_perf_level = lvl;
+	}
 	a6_log("hfi: perf/bw tables, core fw start, start, perf vote %u MHz -> %d\n", gpu_khz[lvl] / 1000, rc);
 
 	wr32(GMU_REG(GMU_H2G_SET), 1u << 30);	/* OOB GPU_SET */
@@ -651,6 +654,28 @@ static int gmu_hfi(struct a6_gpu *g)
 	return 0;
 }
 
+int
+a6_set_perf_level(struct a6_gpu *g, uint32_t lvl)
+{
+	uint32_t msg[4] = { 0 };
+	int rc;
+
+	if (lvl < 1 || lvl >= GPU_LEVELS) {
+		return -1;
+	}
+	if (g->cur_perf_level == lvl) {
+		return 0;
+	}
+	msg[1] = 1;
+	msg[2] = lvl;
+	msg[3] = 0;
+	rc = hfi_send(g, 30, msg, 4);
+	if (rc == 0) {
+		g->cur_perf_level = lvl;
+	}
+	return rc;
+}
+
 /* ---- zap shader through TrustZone PAS ---- */
 
 #define PAS_GPU		13
