 /* Thread context only; 0 success, -1 failure; *out unchanged on failure. */
 int sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out);
+/* PM8150L WLED only (SID 5, 0xd8xx/0xd9xx), if this EE owns it. 0 or -1. */
+int sweet_spmi_write(unsigned sid, unsigned addr, uint8_t value);
 #ifdef __cplusplus
 }
 #endif
diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index f7694ac..7204953 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -459,6 +459,94 @@ IOMobileFramebuffer::setProperties(OSObject *properties)
 	return kIOReturnSuccess;
 }
 
+/*
+ * vayu (Poco X3 Pro): the LCD backlight is the PM8150L WLED (panel DT:
+ * bl_ctrl_wled), SPMI SID 5, control 0xd800, sink 0xd900. Register layout
+ * from mainline drivers/video/backlight/qcom-wled.c (WLED5). Boot-arg
+ * sweetbl_wled=1 drives it from CoreBrightness: brightness on the modulator
+ * the strings use, then that modulator's sync bit; 0 turns the module off.
+ * ABL's current/OVP settings are left alone.
+ */
+#include "../../../bsd/dev/sweet_spmi.h"
+
+#define WLED_SID                5u
+#define WLED_CTRL_MOD_EN        0xd846u /* bit 7: module on */
+#define WLED_SINK_MOD_A_EN      0xd950u
+#define WLED_SINK_MOD_B_EN      0xd960u
+#define WLED_SINK_WIDTH(m)      ((m) ? 0xd962u : 0xd952u)   /* 0: 12-bit, 1: 15-bit */
+#define WLED_SINK_BRIGHT_LSB(m) ((m) ? 0xd963u : 0xd953u)
+#define WLED_SINK_BRIGHT_MSB(m) ((m) ? 0xd964u : 0xd954u)
+#define WLED_SINK_MOD_SYNC      0xd965u /* bit 0: A, bit 1: B */
+#define WLED_SINK_STR0_SRC      0xd973u /* string 0's modulator: 0 A, 1 B */
+
+static int
+sweet_bl_wled_mode(void)
+{
+	static int mode = -1;
+
+	if (mode < 0) {
+		mode = 0;
+		PE_parse_boot_argn("sweetbl_wled", &mode, sizeof(mode));
+	}
+	return mode;
+}
+
+/* 16.16 user brightness (0..0x10000) -> the WLED, 0 = module off. */
+static void
+sweet_bl_wled_level(uint64_t brightness)
+{
+	static int mod = -1;            /* the modulator the strings use, read once */
+	static uint32_t max = 0xfff;
+	static unsigned int logged;
+	uint8_t v = 0, src = 0, a_en = 0, b_en = 0, width = 0;
+	uint32_t level;
+	int rc = 0;
+
+	if (!sweet_bl_wled_mode() || sweet_spmi_init() != 0) {
+		return;
+	}
+	if (mod < 0) {
+		if (sweet_spmi_read(WLED_SID, WLED_SINK_STR0_SRC, &src) != 0 ||
+		    sweet_spmi_read(WLED_SID, WLED_SINK_MOD_A_EN, &a_en) != 0 ||
+		    sweet_spmi_read(WLED_SID, WLED_SINK_MOD_B_EN, &b_en) != 0 ||
+		    sweet_spmi_read(WLED_SID, WLED_CTRL_MOD_EN, &v) != 0) {
+			IOLog("SWEET BL: WLED not readable over SPMI\n");
+			return;
+		}
+		mod = (src & 3) ? 1 : 0;
+		(void)sweet_spmi_read(WLED_SID, WLED_SINK_WIDTH(mod), &width);
+		max = (width & 1) ? 0x7fff : 0xfff;
+		IOLog("SWEET BL: WLED ctrl %x, mod A %x B %x, strings on mod %c, max %x\n",
+		    v, a_en, b_en, mod ? 'B' : 'A', max);
+	}
+	if (brightness == 0) {
+		level = 0;
+	} else if (brightness >= 0x10000) {
+		level = max;
+	} else {
+		level = (uint32_t)(brightness * max >> 16);
+		level = level ? level : 1;
+	}
+	if (sweet_spmi_read(WLED_SID, WLED_CTRL_MOD_EN, &v) != 0) {
+		return;
+	}
+	if (level == 0) {
+		rc = sweet_spmi_write(WLED_SID, WLED_CTRL_MOD_EN, v & ~0x80);
+	} else {
+		rc |= sweet_spmi_write(WLED_SID, WLED_SINK_BRIGHT_LSB(mod), (uint8_t)level);
+		rc |= sweet_spmi_write(WLED_SID, WLED_SINK_BRIGHT_MSB(mod), (uint8_t)(level >> 8));
+		rc |= sweet_spmi_write(WLED_SID, WLED_SINK_MOD_SYNC, 0);
+		rc |= sweet_spmi_write(WLED_SID, WLED_SINK_MOD_SYNC, mod ? 2 : 1);
+		if (!(v & 0x80)) {
+			rc |= sweet_spmi_write(WLED_SID, WLED_CTRL_MOD_EN, v | 0x80);
+		}
+	}
+	if (rc != 0 || logged < 8) {
+		logged++;
+		IOLog("SWEET BL: WLED level %x (%s)\n", level, rc ? "write refused" : "ok");
+	}
+}
+
 IOReturn
 AppleARMBacklight::setProperties(OSObject *properties)
 {
@@ -483,6 +571,7 @@ AppleARMBacklight::setProperties(OSObject *properties)
 		sweet_bl_requested =
 		    sweet_bl_level(number->unsigned64BitValue());
 		sweet_bl_dcs_level(sweet_bl_requested);
+		sweet_bl_wled_level(number->unsigned64BitValue());
 	}
 	return kIOReturnSuccess;
 }
