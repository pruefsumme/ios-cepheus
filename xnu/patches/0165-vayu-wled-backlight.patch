diff --git a/bsd/dev/sweet_spmi.c b/bsd/dev/sweet_spmi.c
index d97eb8a..8b8cf1e 100644
--- a/bsd/dev/sweet_spmi.c
+++ b/bsd/dev/sweet_spmi.c
@@ -7,21 +7,30 @@
  * Also the PM8150 RTC (peripheral 0x60) for the time of day
  * (SweetPlatformExpert.cpp) and the PM8150B (USID 2) FG-gen4/charger
  * registers for the cepheus battery backend (SweetBattery.cpp).
+ *
+ * One exception to read-only, for vayu's LCD backlight: sweet_spmi_write()
+ * may write the PM8150L WLED (SID 5, peripherals 0xd8 control and 0xd9
+ * sink) through this EE's own channel, and only if the arbiter says the
+ * apps EE owns that peripheral.
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <sys/param.h>
 #include <sys/systm.h>
 #include <machine/machine_routines.h>
 #include <IOKit/IOLocks.h>
+#include <vm/memory_types.h>         /* VM_WIMG_IO */
 #include "sweet_spmi.h"
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t, vm_size_t, unsigned int);
 
 #define SP_CORE_PA 0x0c440000u
 #define SP_OBS_PA  0x0e600000u
 #define SP_CFG_PA  0x0c40a000u
 #define SP_NO_APID 0xffffu
 #define SP_USID_PM8150B 2u
+#define SP_CHNLS_PA 0x0c600000u         /* owner channels, 0x10000 per APID */
+#define SP_SID_WLED 5u                  /* PM8150L second SID: WLED 0xd8/0xd9 */
 
 static vm_offset_t sp_core, sp_obs, sp_cfg;
 static IOLock *sp_lock;
@@ -29,6 +38,13 @@ static unsigned sp_count;
 static bool sp_attempted, sp_ready;
 /* A timed-out command may complete late: never reuse that lane this boot. */
 static bool sp_poisoned[512];
+static vm_offset_t sp_chnl[512];        /* write channels, mapped on first use */
+
+static bool
+sp_is_wled(unsigned sid, unsigned peripheral)
+{
+	return sid == SP_SID_WLED && (peripheral == 0xd8 || peripheral == 0xd9);
+}
 
 static uint32_t
 sp_rd(vm_offset_t base, unsigned off)
@@ -108,7 +124,7 @@ sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
 		    peripheral == 0x40 || peripheral == 0x41)) {
 			return -1;
 		}
-	} else {
+	} else if (!sp_is_wled(sid, peripheral)) {
 		return -1;
 	}
 	IOLockLock(sp_lock);
@@ -141,4 +157,46 @@ sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
 	IOLockUnlock(sp_lock);
 	return -1;
 }
+
+int
+sweet_spmi_write(unsigned sid, unsigned addr, uint8_t value)
+{
+	unsigned peripheral = addr >> 8;
+	if (!sp_ready || addr > 0xffffu || !sp_is_wled(sid, peripheral)) {
+		return -1;
+	}
+	IOLockLock(sp_lock);
+	uint16_t apid = sp_find_apid((sid << 8) | peripheral);
+	if (apid == SP_NO_APID || sp_poisoned[apid] ||
+	    (sp_rd(sp_cfg, 0x700u + 4u * apid) & 7u) != 0) {
+		IOLockUnlock(sp_lock);
+		return -1;
+	}
+	if (!sp_chnl[apid]) {
+		/* kernel_map, not the small io_submap ml_io_map uses (NOTES.md, 0160) */
+		sp_chnl[apid] = ml_io_map_unmappable(SP_CHNLS_PA + 0x10000u * apid, 0x1000, VM_WIMG_IO);
+	}
+	vm_offset_t ch = sp_chnl[apid];
+	if (!ch) {
+		IOLockUnlock(sp_lock);
+		return -1;
+	}
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(ch + 0x10u) = value;                   /* WDATA0 */
+	*(volatile uint32_t *)(ch + 0x00u) = (addr & 0xffu) << 4;     /* EXT_WRITEL, BC=0 */
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t status = sp_rd(ch, 0x08u);
+		if (status & 1u) {
+			IOLockUnlock(sp_lock);
+			return (status & 0x0eu) ? -1 : 0;
+		}
+		delay(1);
+	}
+	sp_poisoned[apid] = true;
+	printf("SWEET BATTERY: SPMI write timeout sid=%u addr=%#x APID=%u disabled\n",
+	    sid, addr, apid);
+	IOLockUnlock(sp_lock);
+	return -1;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_spmi.h b/bsd/dev/sweet_spmi.h
index 45565d1..36488df 100644
