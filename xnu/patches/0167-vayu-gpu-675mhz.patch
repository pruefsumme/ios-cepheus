+/*
+ * The GPU's speed bin from QFPROM (DT kgsl qfprom_memory 0x780000 and
+ * qcom,gpu-speed-bin = <0x4130 0xe0000000 29>). vayu reads 1 (fuse
+ * 0x306300a5), which allows 675 MHz; bin 0 tops out at 585.
+ */
+#define QFPROM_PA		0x00780000u
+#define GPU_SPEED_BIN_OFF	0x4130u
+
+static uint32_t
+gpu_speed_bin(void)
+{
+	static vm_offset_t qfprom;
+	if (!qfprom) {
+		qfprom = ml_io_map_unmappable(QFPROM_PA, 0x7000, VM_WIMG_IO);
+	}
+	if (!qfprom) {
+		return 0;
+	}
+	return *(volatile uint32_t *)(qfprom + GPU_SPEED_BIN_OFF) >> 29;
+}
+
 /*
  * DDR (BCM MC0) and the memory NoC (SH0) at their top levels: nothing else votes them for the GPU (mainline
  * sm8150 has no GPU interconnect path either), and ABL's level left 8-thread CPU bandwidth at 13.7 GB/s
@@ -287,8 +308,12 @@ sweet_gpu_init(void)
 	}
 	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)va);
 	a6_init_state(&gpu, ptoa_64(pn));
-	uint32_t lvl = 4;	/* 499 MHz; boot-arg sweetgpufreq=1 (257) .. 5 (585) */
+	uint32_t lvl = 4;	/* 499 MHz; boot-arg sweetgpufreq=1 (257) .. 5 (585), 6 (675, speed bin 1 only) */
 	PE_parse_boot_argn("sweetgpufreq", &lvl, sizeof(lvl));
+	if (lvl >= 6 && gpu_speed_bin() != 1) {
+		a6_log("675 MHz needs a speed-bin 1 GPU (fuse says %u): using 585\n", gpu_speed_bin());
+		lvl = 5;
+	}
 	gpu.perf_level = lvl;
 	pool_kva = va;
 	vm_offset_t pva = 0;
