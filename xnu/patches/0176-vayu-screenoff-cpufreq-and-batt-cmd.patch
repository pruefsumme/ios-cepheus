@@ -40,19 +48,30 @@ osm_rd(vm_offset_t base, uint32_t off)
 	return v;
 }
 
+static void
+osm_wr_desired(vm_offset_t base, uint32_t idx)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + OSM_DESIRED) = idx;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
 void
 sweet_cpufreq_init(void)
 {
 	unsigned want = 1;
 	(void)PE_parse_boot_argn("cepheuscpufreq", &want, sizeof(want));
+	(void)PE_parse_boot_argn("sweetcpuidle", &cpuidle_en, sizeof(cpuidle_en));
 	for (unsigned c = 0; c < sizeof(osm_clusters) / sizeof(osm_clusters[0]); ++c) {
-		vm_offset_t base = ml_io_map(osm_clusters[c].pa, 0x1000);
+		vm_offset_t base = ml_io_map_unmappable(osm_clusters[c].pa, 0x1000, VM_WIMG_IO);
 		if (!base) {
 			printf("SWEET CPUFREQ: %s: map failed\n", osm_clusters[c].name);
 			continue;
 		}
+		osm_base[c] = base;
 		uint32_t cur = osm_rd(base, OSM_DESIRED);
 		unsigned best = cur, best_khz = 0, prev_khz = 0, n = 0;
+		unsigned idle_idx = 0, idle_khz = ~0u;
 		char line[256];
 		unsigned len = 0;
 		for (unsigned i = 0; i < OSM_ROWS; ++i) {
@@ -69,7 +88,14 @@ sweet_cpufreq_init(void)
 				    cores == 1 ? "*" : "");
 			}
 			/* core count 1 = single-core boost entry: skip, as Linux does */
-			if (cores == 1 || (want > 1 && khz / 1000 > want)) {
+			if (cores == 1) {
+				continue;
+			}
+			if (khz < idle_khz) {
+				idle_khz = khz;
+				idle_idx = i;
+			}
+			if (want > 1 && khz / 1000 > want) {
 				continue;
 			}
 			if (khz > best_khz) {
@@ -82,11 +108,50 @@ sweet_cpufreq_init(void)
 			printf("SWEET CPUFREQ: %s index %u kept\n", osm_clusters[c].name, cur);
 			continue;
 		}
-		__asm__ volatile("dmb oshst" ::: "memory");
-		*(volatile uint32_t *)(base + OSM_DESIRED) = best;
-		__asm__ volatile("dsb osh" ::: "memory");
-		printf("SWEET CPUFREQ: %s index %u -> %u (%u MHz), reads back %u\n",
-		    osm_clusters[c].name, cur, best, best_khz / 1000, osm_rd(base, OSM_DESIRED));
+		osm_wr_desired(base, best);
+		osm_active_idx[c] = best;
+		osm_active_mhz[c] = best_khz / 1000;
+		if (idle_khz != ~0u && idle_idx < n) {
+			osm_idle_idx[c] = idle_idx;
+			osm_idle_mhz[c] = idle_khz / 1000;
+		} else {
+			osm_idle_idx[c] = best;
+			osm_idle_mhz[c] = best_khz / 1000;
+		}
+		osm_ready[c] = true;
+		printf("SWEET CPUFREQ: %s index %u -> %u (%u MHz), idle %u (%u MHz), reads back %u\n",
+		    osm_clusters[c].name, cur, best, best_khz / 1000,
+		    osm_idle_idx[c], osm_idle_mhz[c], osm_rd(base, OSM_DESIRED));
+	}
+}
+
+void
+sweet_cpufreq_set_screen_off(int off)
+{
+	static int last_off = -1;
+	static unsigned logs;
+	unsigned mhz[3];
+	unsigned idx[3];
+	unsigned c;
+
+	if (!cpuidle_en || off == last_off) {
+		return;
+	}
+	last_off = off;
+	for (c = 0; c < 3; ++c) {
+		if (osm_ready[c] && osm_base[c]) {
+			idx[c] = off ? osm_idle_idx[c] : osm_active_idx[c];
+			mhz[c] = off ? osm_idle_mhz[c] : osm_active_mhz[c];
+			osm_wr_desired(osm_base[c], idx[c]);
+		} else {
+			idx[c] = 0;
+			mhz[c] = 0;
+		}
+	}
+	if (logs < 16) {
+		logs++;
+		printf("SWEET CPUFREQ: screen %s -> A55 %u MHz (%u), A76 %u MHz (%u), Prime %u MHz (%u)\n",
+		    off ? "off" : "on", mhz[0], idx[0], mhz[1], idx[1], mhz[2], idx[2]);
 	}
 }
