diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
index 1320b8f..63fa215 100644
--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -45,6 +45,7 @@ extern void sweet_smc(uint64_t x[8]);
 
 void sweet_gpu_init(void);
 bool sweet_gpu_ready(void);
+void sweet_gpu_present_idle(void);
 int sweet_gpu_surface_slot(uint64_t key);
 int sweet_gpu_map_surface(uint64_t key, const uint64_t *pages, uint32_t npages, uint32_t page_size);
 int sweet_gpu_present(int slot, uintptr_t kva, uint32_t offset, uint32_t w, uint32_t h, uint32_t pitch,
@@ -545,6 +546,23 @@ present_wait_locked(uint32_t k, const char *why)
 	}
 	return 0;
 }
+
+/*
+ * Wait until no queued present is still writing the panel. The display-off
+ * path calls this before it blacks the panel out; a present landing after
+ * that (its corner band is written last) would repaint the top of the screen.
+ */
+void
+sweet_gpu_present_idle(void)
+{
+	if (!gpu_ready) {
+		return;
+	}
+	lck_mtx_lock(&sweet_gpu_lock);
+	(void)present_wait_locked(0, "display off");
+	(void)present_wait_locked(1, "display off");
+	lck_mtx_unlock(&sweet_gpu_lock);
+}
 #define PANEL_W         SWEET_PANEL_W
 #define PANEL_H         SWEET_PANEL_H
 #define DISPLAY_MASK_OFF        0x500000ULL     /* 2x2 corner mattes, one per corner */
