diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 2eb7a4a..0c4874b 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -107,6 +107,12 @@ enum {
 static int sweet_fb_sel_log;
 /* boot-arg sweetfb_async_log=1: log every async call/completion, not just the first per selector */
 static int sweet_fb_async_log;
+/*
+ * sweetfb_fade=0: go black in one write on display off. The halving fade
+ * suits an AMOLED (black pixels are off); on an LCD whose backlight stays on
+ * (vayu) the CPU-drawn steps show as black bands creeping over the screen.
+ */
+static int sweet_fb_fade = 1;
 
 /*
  * 0141: bumped by kSweetFBRequestPowerChange when the display turns on.
@@ -796,6 +802,7 @@ AppleCLCD::start(IOService *provider)
 	PE_parse_boot_argn("sweetfb_hz", &hz, sizeof(hz));
 	PE_parse_boot_argn("sweetfb_sel_log", &sweet_fb_sel_log, sizeof(sweet_fb_sel_log));
 	PE_parse_boot_argn("sweetfb_async_log", &sweet_fb_async_log, sizeof(sweet_fb_async_log));
+	PE_parse_boot_argn("sweetfb_fade", &sweet_fb_fade, sizeof(sweet_fb_fade));
 	fFlushTicks = (hz == 0 || hz >= 60) ? 1 : 60 / hz;
 	fVsync->setTimeoutUS(SWEET_FB_VSYNC_US);
 
@@ -865,16 +872,16 @@ AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
 	}
 	if (fb->fPowerOff) {
 		/* Fade out: halve every channel each vsync, then black, then idle. */
-		uint32_t step = fb->fFadeStep;
-		if (step <= 6) {
+		uint32_t step = fb->fFadeStep, last = sweet_fb_fade ? 6 : 0;
+		if (step <= last) {
 			fb->fFadeStep = step + 1;
 		}
 		IOLockUnlock(fb->fLock);
-		if (step <= 6) {
+		if (step <= last) {
 			for (uint32_t y = 0; y < fb->fHeight; y++) {
 				volatile uint32_t *row = (volatile uint32_t *)(fb->fPixels + (uint64_t)y * fb->fRowBytes);
 				for (uint32_t x = 0; x < fb->fWidth; x++) {
-					row[x] = step < 6 ? (row[x] >> 1) & 0x7f7f7f7f : 0;
+					row[x] = step < last ? (row[x] >> 1) & 0x7f7f7f7f : 0;
 				}
 			}
 		}
